<%- include("partials/header") %>

    <h1>Admin Page</h1>

    <p>Welcome, <%= user.name %>
    </p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>User Type</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(function(u) { %>
                <%- include('partials/user', { u: u }) %>
                    <% }); %>
        </tbody>
    </table>

    <%- include('partials/footer') %>