<tr>
    <td>
        <%= u.name %>
    </td>
    <td>
        <%= u.email %>
    </td>
    <td>
        <%= u.user_type %>
    </td>
    <td>
        <% if (u.user_type==="user" ) { %>

            <a href="/promote/<%= u.email %>" class="btn btn-success btn-sm">
                Promote to Admin
            </a>

            <% } else { %>

                <a href="/demote/<%= u.email %>" class="btn btn-danger btn-sm">
                    Demote to User
                </a>

                <% } %>
    </td>
</tr>